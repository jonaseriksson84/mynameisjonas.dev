---
// Sparse, static dither specks in the side margins of reading pages. They
// thin out toward the reading column and never sit behind text, so the page
// has texture without costing legibility.
---

<canvas class="speck-field" aria-hidden="true"></canvas>

<style>
  .speck-field {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    width: 100vw; height: 100vh; display: block; image-rendering: pixelated;
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.speck-field')!;
  const ctx = canvas.getContext('2d')!;
  const CELL = 4;
  const DOT = 2;
  const GAP = 32; // clear air between specks and the reading column

  function hash(x: number, y: number) {
    const h = Math.sin(x * 127.1 + y * 311.7) * 43758.5453;
    return h - Math.floor(h);
  }

  function smoothstep(a: number, b: number, x: number) {
    const t = Math.min(1, Math.max(0, (x - a) / (b - a)));
    return t * t * (3 - 2 * t);
  }

  function draw() {
    const dpr = Math.min(window.devicePixelRatio || 1, 3);
    const W = window.innerWidth;
    const H = window.innerHeight;
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    const column = document.querySelector('[data-reading]')?.getBoundingClientRect();
    const left = column ? column.left - GAP : W / 2;
    const right = column ? column.right + GAP : W / 2;
    if (left < CELL * 4) return; // no real margins on narrow screens

    const dotPx = Math.max(1, Math.floor(DOT * dpr));
    const groups = [new Path2D(), new Path2D(), new Path2D()];
    for (let y = 0; y < H; y += CELL) {
      for (let x = 0; x < W; x += CELL) {
        if (x > left && x < right) continue;
        // 0 at the column edge, 1 at the screen edge.
        const m = x <= left ? (left - x) / left : (x - right) / (W - right);
        const chance = 0.028 * smoothstep(0.05, 1, m) ** 2;
        const i = x / CELL, j = y / CELL;
        if (hash(i + 1000, j) < chance) {
          groups[Math.floor(hash(i, j + 1000) * 3)].rect(Math.round(x * dpr), Math.round(y * dpr), dotPx, dotPx);
        }
      }
    }
    ctx.fillStyle = '#cfcfcb';
    groups.forEach((g, k) => {
      ctx.globalAlpha = 0.18 + 0.18 * k;
      ctx.fill(g);
    });
  }

  let pending = 0;
  window.addEventListener('resize', () => {
    cancelAnimationFrame(pending);
    pending = requestAnimationFrame(draw);
  });
  draw();
</script>
