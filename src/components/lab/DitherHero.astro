---
// Throwaway prototype: full-screen dithered portrait hero. Not linked from nav.
// Mono base; only --accent changes. Visitors can pick their own accent,
// remembered per browser. First entry is the default.
const accents = [
  ['yellow', '#f5e70a'],
  ['orange', '#ff6a1a'],
  ['red', '#ff3b24'],
  ['lime', '#b6ff3b'],
  ['mint', '#3dffb0'],
  ['cyan', '#22d3ee'],
  ['blue', '#3d5afe'],
  ['violet', '#9b7bff'],
  ['pink', '#ff3ea5'],
  ['grey', '#8a8a86'],
];
const ACCENT_KEY = 'accent';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>lab — mynameisjonas</title>
    <script is:inline define:vars={{ ACCENT_KEY }}>
      // Apply a remembered accent before first paint to avoid a color flash.
      try {
        const saved = localStorage.getItem(ACCENT_KEY);
        if (saved && /^#[0-9a-f]{6}$/i.test(saved)) document.documentElement.style.setProperty('--accent', saved);
      } catch {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #050505; --fg: #e9e9e6; --muted: #8a8a86; --line: #262624;
        --grid: #1c1c1a; --dot: #e9e9e6; --accent: #f5e70a;
      }
      .prompt, .cmds a::before { color: var(--accent) !important; }
      .caret { background: var(--accent) !important; }
      * { box-sizing: border-box; margin: 0; }
      html, body { height: 100%; background: var(--bg); color: var(--fg); }
      body {
        font-family: 'Geist Mono', ui-monospace, monospace;
        overflow: hidden;
        /* Faint static dot grid, like a screen at rest. */
        background-image: radial-gradient(circle, var(--grid) 1px, transparent 1.2px);
        background-size: 8px 8px;
      }
      canvas { position: fixed; inset: 0; width: 100vw; height: 100dvh; display: block; image-rendering: pixelated; }
      nav {
        position: fixed; top: 0; left: 0; right: 0; z-index: 2;
        display: flex; justify-content: space-between; align-items: center;
        padding: 20px clamp(16px, 5vw, 64px);
        font-size: 13px; letter-spacing: 0.04em; text-transform: uppercase;
      }
      nav .links { display: flex; gap: 24px; }
      a { color: inherit; text-decoration: none; }
      nav a:hover, .cmds a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 4px; }
      main {
        position: fixed; z-index: 2;
        left: clamp(16px, 5vw, 64px); bottom: clamp(32px, 10vh, 120px);
        max-width: 560px;
      }
      .prompt { color: var(--muted); font-size: 13px; margin-bottom: 20px; }
      h1 {
        font-weight: 500; font-size: clamp(40px, 7vw, 88px);
        line-height: 0.95; letter-spacing: -0.03em;
      }
      .caret {
        display: inline-block; width: 0.5em; height: 0.8em; background: var(--fg);
        margin-left: 0.08em; vertical-align: -0.02em; animation: blink 1.1s steps(1) infinite;
      }
      .role { margin-top: 20px; font-size: 15px; line-height: 1.6; color: var(--muted); max-width: 44ch; }
      .role a { color: var(--fg); border-bottom: 1px dashed var(--accent); }
      .role a:hover { color: var(--accent); }
      .cmds {
        margin-top: 28px; padding-top: 16px; border-top: 1px dashed var(--line);
        display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 14px;
      }
      .cmds a::before { content: '> '; color: var(--muted); }
      .accents {
        margin-top: 20px; display: flex; flex-wrap: wrap; gap: 5px; align-items: center;
        font-size: 12px; color: var(--muted);
        opacity: 0.55; transition: opacity 200ms ease;
      }
      .accents:hover, .accents:focus-within { opacity: 1; }
      .accents .label { margin-left: 8px; }
      .accents .label output { color: var(--accent); }
      .accents button, .accents label {
        width: 9px; height: 9px; padding: 0; border: 0; cursor: pointer;
        background: var(--swatch); transition: transform 150ms ease;
      }
      .accents button:hover, .accents label:hover { transform: scale(1.35); }
      .accents button[aria-pressed='true'] { box-shadow: 0 0 0 1px var(--bg), 0 0 0 2px var(--fg); }
      .accents label { position: relative; background: conic-gradient(red, yellow, lime, cyan, blue, magenta, red); }
      .accents input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
      @keyframes blink { 50% { opacity: 0; } }
      @media (max-width: 720px) {
        main { bottom: 20px; right: 16px; }
        .prompt { margin-bottom: 12px; }
        h1 { font-size: 40px; }
        .role { margin-top: 14px; font-size: 13px; line-height: 1.55; }
        .cmds { margin-top: 18px; padding-top: 12px; }
        .accents { margin-top: 14px; }
      }
      @media (prefers-reduced-motion: reduce) {
        .caret { animation: none; }
      }
    </style>
  </head>
  <body>
    <canvas id="dither" aria-hidden="true"></canvas>
    <nav>
      <a href="/">mynameisjonas</a>
      <div class="links">
        <a href="/blog">Blog</a>
        <a href="/projects">Projects</a>
        <a href="/cv">CV</a>
      </div>
    </nav>
    <main>
      <p class="prompt">~ $ whoami</p>
      <h1>Jonas<br />Eriksson<span class="caret"></span></h1>
      <p class="role">
        Fullstack engineer, tech lead and manager at
        <a href="https://www.embark-studios.com" target="_blank" rel="noopener noreferrer">Embark Studios</a>.
        Building ARC Raiders and THE FINALS. Side projects in agents and apps.
      </p>
      <div class="cmds">
        <a href="/cv">cv</a>
        <a href="/projects">projects</a>
        <a href="/blog">blog</a>
        <a href="https://github.com/jonaseriksson84" target="_blank" rel="noopener noreferrer">github</a>
      </div>
      <div class="accents" role="group" aria-label="Accent color">
        {accents.map(([name, hex]) => (
          <button type="button" data-name={name} data-hex={hex} title={name} aria-label={name} aria-pressed="false" style={`--swatch:${hex}`} />
        ))}
        <label title="custom"><input type="color" id="accent-custom" aria-label="Custom accent" /></label>
        <span class="label">$ accent <output id="accent-name"></output></span>
      </div>
    </main>

    <script>
      const canvas = document.getElementById('dither') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d')!;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const DOT_COLOR = '#cfcfcb';
      let accent = '#f5e70a';
      const ACCENT_KEY = 'accent';

      // Dot pitch and size in CSS px. Finer on small screens, where the portrait
      // is narrower and a 4px pitch leaves too few dots to read a face.
      let CELL = 4;
      let DOT = 2;
      const CHAR_CELL = 11; // coarser grid for the ASCII lens
      const LENS_R = 160;
      const RAMP = ' .:-=+*#%@';
      // 4x4 Bayer matrix, normalized to thresholds in (0,1).
      const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map((v) => (v + 0.5) / 16);

      let W = 0, H = 0, dpr = 1;
      let box = { x: 0, y: 0, size: 0 }; // portrait square in CSS px
      let cols = 0, lum = new Float32Array(0);
      const mouse = { x: -9999, y: -9999, lastMove: -Infinity };
      // Lens trails the pointer and fades in while moving, out when idle.
      const lens = { x: -9999, y: -9999, strength: 0 };
      let img: HTMLImageElement | null = null;
      const start = performance.now();

      function layout() {
        // Full device resolution: a capped canvas gets stretched and smoothed by
        // the browser on 3x screens, which smears dots bigger and brighter.
        dpr = Math.min(window.devicePixelRatio || 1, 3);
        W = window.innerWidth;
        H = window.innerHeight;
        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        CELL = W > 720 ? 4 : 3;
        // Dots at half the pitch leave visible air even in the brightest areas.
        DOT = W > 720 ? 2 : 1.5;

        // Desktop: large square anchored bottom-right. Mobile: fit between the
        // nav and the text block, measured live since browser toolbars vary.
        let size: number, x: number, y: number;
        if (W > 720) {
          size = Math.min(H * 1.05, W * 0.62);
          x = W - size * 0.92;
          y = H - size;
        } else {
          const top = 48;
          const textTop = document.querySelector('main')!.getBoundingClientRect().top;
          // The portrait fades out at its bottom edge, so it may tuck a little
          // under the prompt line without hurting legibility.
          size = Math.max(180, Math.min(W * 1.05, (textTop - top) / 0.92));
          x = (W - size) / 2;
          // When width is the limit, center the portrait in the free space.
          y = top + Math.max(0, (textTop - top - size * 0.92) / 2);
        }
        box = { x: Math.round(x / CELL) * CELL, y: Math.round(y / CELL) * CELL, size };
        cols = Math.floor(size / CELL);
        scatter();
        if (img) sample(img);
      }

      // Downsample the photo to one luminance value per cell, with contrast
      // and an elliptical fade so the busy background drops to black.
      function sample(image: HTMLImageElement) {
        const off = document.createElement('canvas');
        off.width = off.height = cols;
        const o = off.getContext('2d', { willReadFrequently: true })!;
        o.drawImage(image, 0, 0, cols, cols);
        const px = o.getImageData(0, 0, cols, cols).data;
        const n = cols * cols;
        const raw = new Float32Array(n);
        for (let p = 0; p < n; p++) {
          const k = p * 4;
          raw[p] = (0.2126 * px[k] + 0.7152 * px[k + 1] + 0.0722 * px[k + 2]) / 255;
        }
        // Unsharp mask: the source photo is small and soft, so boosting local
        // contrast is what keeps eyes and beard readable once dithered.
        // Radius scales with resolution so the halo stays the same size on the face.
        const blur = boxBlur(raw, cols, Math.max(1, Math.round(cols / 75)));
        // A much wider blur for "clarity": boosting against it brings out the
        // broad shape of forehead, cheeks and jaw so the face reads as 3D.
        const wide = boxBlur(raw, cols, Math.max(2, Math.round(cols / 18)));
        lum = new Float32Array(n);
        for (let j = 0; j < cols; j++) {
          for (let i = 0; i < cols; i++) {
            const p = j * cols + i;
            // Phones get a touch more detail; features shrink on a small screen.
            const detail = W > 720 ? 0.7 : 1.0;
            let l = raw[p] + detail * (raw[p] - blur[p]) + 0.3 * (raw[p] - wide[p]);
            l = Math.pow(smoothstep(0.2, 1.0, l), 1.7);
            // Mild S-curve for separation between lit and shaded planes.
            l = l + 0.15 * (smoothstep(0, 1, l) - l);
            // Deliberately dim: the portrait is texture, not a photo, and should
            // sit behind the headline rather than compete with it.
            // Phones get more gain: the sparser grid there needs it to read as a face.
            l *= W > 720 ? 0.62 : 0.8;
            // Soft knee on highlights so teeth and eye whites don't glow, and a
            // small shadow lift so dark gaps (mouth, eye sockets) aren't holes.
            if (l > 0.55) l = 0.55 + (l - 0.55) * 0.2;
            l = 0.04 + l;
            const dx = (i / cols - 0.5) / 0.36;
            const dy = (j / cols - 0.56) / 0.5;
            const r = Math.sqrt(dx * dx + dy * dy);
            const mask = 1 - smoothstep(0.72, 1.0, r);
            // Sparse random specks around the head so the surroundings aren't
            // dead black. Baked as on/off so they don't form a regular grid.
            const hazeChance = 0.07 * (1 - smoothstep(0.95, 1.4, r)) * smoothstep(0.03, 0.14, j / cols);
            const haze = hash(i, j) < hazeChance ? 1 : 0;
            lum[p] = haze + (l - haze) * mask;
          }
        }
      }

      // Sparse specks across the whole screen, a little denser toward the
      // portrait, so the dithering bleeds into the page instead of stopping at
      // the portrait's edge. Each speck gets a phase for a slow twinkle.
      let specks: { x: number; y: number; phase: number }[] = [];
      function scatter() {
        specks = [];
        const cx = box.x + box.size / 2, cy = box.y + box.size * 0.55;
        const reach = Math.max(W, H);
        // Keep text crisp: no specks behind the nav or the text block.
        const clear = ['nav', 'main'].map((sel) => document.querySelector(sel)!.getBoundingClientRect());
        for (let y = 0; y < H; y += CELL) {
          for (let x = 0; x < W; x += CELL) {
            // The portrait draws its own haze inside its box.
            if (x >= box.x && x < box.x + box.size && y >= box.y && y < box.y + box.size) continue;
            if (clear.some((r) => x > r.left - 8 && x < r.right + 8 && y > r.top - 8 && y < r.bottom + 8)) continue;
            const d = Math.hypot(x - cx, y - cy) / reach;
            const chance = 0.004 + 0.02 * (1 - smoothstep(0.2, 0.7, d));
            const i = x / CELL, j = y / CELL;
            if (hash(i + 1000, j) < chance) specks.push({ x, y, phase: hash(i, j + 1000) * Math.PI * 2 });
          }
        }
      }

      function hash(x: number, y: number) {
        const h = Math.sin(x * 127.1 + y * 311.7) * 43758.5453;
        return h - Math.floor(h);
      }

      function boxBlur(src: Float32Array, size: number, r: number) {
        const out = new Float32Array(src.length);
        for (let j = 0; j < size; j++) {
          for (let i = 0; i < size; i++) {
            let sum = 0, count = 0;
            for (let y = Math.max(0, j - r); y <= Math.min(size - 1, j + r); y++) {
              for (let x = Math.max(0, i - r); x <= Math.min(size - 1, i + r); x++) {
                sum += src[y * size + x];
                count++;
              }
            }
            out[j * size + i] = sum / count;
          }
        }
        return out;
      }

      function smoothstep(a: number, b: number, x: number) {
        const t = Math.min(1, Math.max(0, (x - a) / (b - a)));
        return t * t * (3 - 2 * t);
      }

      function cellAt(cx: number, cy: number) {
        const i = Math.floor((cx - box.x) / CELL);
        const j = Math.floor((cy - box.y) / CELL);
        if (i < 0 || j < 0 || i >= cols || j >= cols) return -1;
        return j * cols + i;
      }

      function frame(now: number) {
        const t = reduceMotion ? 10 : (now - start) / 1000;
        ctx.clearRect(0, 0, W, H);

        // Boot-in: a sweep line reveals the image top to bottom, with noise below it.
        const sweep = reduceMotion ? Infinity : box.y + (t / 1.4) * box.size;
        // CRT-ish scan band that drifts down every few seconds.
        const band = box.y + ((t * 0.18) % 1.4) * box.size;

        const moving = now - mouse.lastMove < 700;
        lens.strength += ((moving ? 1 : 0) - lens.strength) * 0.06;
        if (lens.x < -999) { lens.x = mouse.x; lens.y = mouse.y; }
        lens.x += (mouse.x - lens.x) * 0.18;
        lens.y += (mouse.y - lens.y) * 0.18;
        const lensOn = lens.strength > 0.01;

        // Dots are built in device pixels and snapped to whole pixels so every
        // dot is crisp and the same size regardless of screen density.
        const dotPx = Math.max(1, Math.floor(DOT * dpr));
        const fg = new Path2D();
        for (let j = 0; j < cols; j++) {
          const y = box.y + j * CELL;
          for (let i = 0; i < cols; i++) {
            const x = box.x + i * CELL;
            const l = lum[j * cols + i];
            const thr = BAYER[(j & 3) * 4 + (i & 3)];
            if (l < 0.01) continue;
            if (lensOn) {
              // Dissolve dots through the dither pattern rather than cutting a hole.
              const dx = x - lens.x, dy = y - lens.y;
              const f = lens.strength * (1 - smoothstep(LENS_R * 0.3, LENS_R, Math.sqrt(dx * dx + dy * dy)));
              if (f * 0.8 > thr) continue;
            }
            // Scale effects by presence so the faded-out background stays black.
            const presence = Math.min(1, l * 4);
            let v: number;
            if (y > sweep) {
              v = y - sweep < 40 ? Math.random() * presence : 0;
            } else {
              v = l + 0.07 * presence * Math.sin(i * 0.09 + t * 0.9) * Math.sin(j * 0.07 - t * 0.6);
              const bd = Math.abs(y - band);
              if (bd < 18) v += 0.18 * presence * (1 - bd / 18);
            }
            if (v > thr) fg.rect(Math.round(x * dpr), Math.round(y * dpr), dotPx, dotPx);
          }
        }
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = DOT_COLOR;
        ctx.fill(fg);

        // Specks twinkle in a few brightness groups; one fill per group.
        const groups = [new Path2D(), new Path2D(), new Path2D(), new Path2D()];
        for (const sp of specks) {
          const a = 0.5 + 0.5 * Math.sin(t * 0.5 + sp.phase);
          groups[Math.min(3, Math.floor(a * 4))].rect(Math.round(sp.x * dpr), Math.round(sp.y * dpr), dotPx, dotPx);
        }
        groups.forEach((g, k) => {
          ctx.globalAlpha = 0.15 + 0.2 * k;
          ctx.fill(g);
        });
        ctx.globalAlpha = 1;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        // ASCII lens under the cursor.
        if (lensOn) {
          ctx.font = `500 ${CHAR_CELL}px 'Geist Mono', monospace`;
          ctx.textBaseline = 'top';
          // The lens is the one place the accent touches the portrait.
          ctx.fillStyle = accent;
          const x0 = Math.floor((lens.x - LENS_R) / CHAR_CELL) * CHAR_CELL;
          const y0 = Math.floor((lens.y - LENS_R) / CHAR_CELL) * CHAR_CELL;
          for (let y = y0; y < lens.y + LENS_R; y += CHAR_CELL) {
            for (let x = x0; x < lens.x + LENS_R; x += CHAR_CELL) {
              const dx = x + CHAR_CELL / 2 - lens.x, dy = y + CHAR_CELL / 2 - lens.y;
              const f = lens.strength * (1 - smoothstep(LENS_R * 0.3, LENS_R, Math.sqrt(dx * dx + dy * dy)));
              if (f < 0.05) continue;
              const p = cellAt(x + CHAR_CELL / 2, y + CHAR_CELL / 2);
              if (p < 0) continue;
              const idx = Math.min(RAMP.length - 1, Math.floor(lum[p] * RAMP.length));
              if (idx === 0) continue;
              ctx.globalAlpha = 0.7 * f;
              ctx.fillText(RAMP[idx], x, y);
            }
          }
        }

        ctx.globalAlpha = 1;
        if (!reduceMotion) requestAnimationFrame(frame);
      }

      const swatches = [...document.querySelectorAll<HTMLButtonElement>('[data-hex]')];
      const nameOut = document.getElementById('accent-name')!;
      const custom = document.getElementById('accent-custom') as HTMLInputElement;

      function setAccent(hex: string, remember = true) {
        accent = hex;
        document.documentElement.style.setProperty('--accent', hex);
        const match = swatches.find((b) => b.dataset.hex === hex);
        swatches.forEach((b) => b.setAttribute('aria-pressed', String(b === match)));
        nameOut.textContent = match ? match.dataset.name! : hex;
        custom.value = hex;
        if (remember) {
          try { localStorage.setItem(ACCENT_KEY, hex); } catch {}
        }
        if (reduceMotion && img) frame(0);
      }

      swatches.forEach((b) => b.addEventListener('click', () => setAccent(b.dataset.hex!)));
      custom.addEventListener('input', () => setAccent(custom.value));

      // ?accent=<name|#hex> previews a color without overwriting the saved one.
      const isHex = (v: string | null) => !!v && /^#[0-9a-f]{6}$/i.test(v);
      const param = new URLSearchParams(location.search).get('accent');
      const fromParam = swatches.find((b) => b.dataset.name === param)?.dataset.hex ?? (isHex(param) ? param : null);
      let saved: string | null = null;
      try { saved = localStorage.getItem(ACCENT_KEY); } catch {}
      setAccent(fromParam ?? (isHex(saved) ? saved! : swatches[0].dataset.hex!), false);

      window.addEventListener('resize', () => {
        layout();
        if (reduceMotion) frame(0);
      });
      if (!reduceMotion) {
        window.addEventListener('pointermove', (e) => {
          // Touch drags are for scrolling; the lens is a mouse-only flourish.
          if (e.pointerType === 'touch') return;
          mouse.x = e.clientX;
          mouse.y = e.clientY;
          mouse.lastMove = performance.now();
        });
      }

      layout();
      const image = new Image();
      image.src = '/jonas.jpg';
      image.onload = () => {
        img = image;
        sample(image);
        requestAnimationFrame(frame);
      };
    </script>
  </body>
</html>
