---
import { education } from '../../data/cv';
---

<section>
  <h2 class="cv-heading"><span aria-hidden="true">$ cat </span>education</h2>
  <div class="cv-jobs">
    {education.map((entry) => (
      <article class="cv-job">
        <div class="cv-job-head">
          <h3>{entry.degree} <span class="at">@ {entry.institution}</span></h3>
          <span class="cv-period">{entry.period}</span>
        </div>
        {entry.details.length > 0 && (
          <ul class="cv-points">
            {entry.details.map((detail) => <li>{detail}</li>)}
          </ul>
        )}
      </article>
    ))}
  </div>
</section>
