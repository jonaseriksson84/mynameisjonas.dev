---
import { getGroupedJobs } from '../../data/cv';

const groupedJobs = getGroupedJobs();
---

<section>
  <h2 class="cv-heading"><span aria-hidden="true">$ cat </span>experience</h2>
  <div class="cv-jobs">
    {groupedJobs.map((group) => {
      const jobs = group.map((job) => (
        <article class="cv-job">
          <div class="cv-job-head">
            <h3>{job.title} <span class="at">@ {job.company}</span></h3>
            <span class="cv-period">{job.period}</span>
          </div>
          <ul class="cv-points">
            {job.achievements.map((achievement) => <li>{achievement}</li>)}
          </ul>
          <p class="cv-tags">{job.buzzwords.join(' · ')}</p>
        </article>
      ));
      return group[0].consultancy ? (
        <div class="cv-consultancy">
          <span class="cv-via">[via {group[0].consultancy}]</span>
          {jobs}
        </div>
      ) : jobs;
    })}
  </div>
</section>
