---
import { techStack } from '../../data/cv';
---

<section>
  <details class="cv-fold">
    <summary class="cv-heading"><span aria-hidden="true">$ ls </span>stack</summary>
    <dl class="cv-stack">
      {techStack.map((category) => (
        <div>
          <dt>{category.title}</dt>
          <dd>{category.items.join(' · ')}</dd>
        </div>
      ))}
    </dl>
  </details>
</section>
