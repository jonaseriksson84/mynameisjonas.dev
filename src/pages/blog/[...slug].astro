---
import TerminalLayout from '../../layouts/TerminalLayout.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import BookMeta from '../../components/BookMeta.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { getCollection, render } from 'astro:content';
import { getSeries, getSeriesNavigation, getSeriesOverviewUrl } from '../../lib/series';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const data = entry.data;
const fileName = `${entry.id.split('/').pop()}.md`;
const seriesData = data.type === 'seriesPart' ? data : null;
const bookData = data.type === 'bookReview' ? data : null;

const series = seriesData ? await getSeries(seriesData.series) : null;
const { prev: prevPost, next: nextPost } = series
  ? getSeriesNavigation(series, entry.id)
  : { prev: null, next: null };
---

<TerminalLayout
  title={bookData ? `Book Review: ${bookData.book.title} — mynameisjonas` : `${data.title} — mynameisjonas`}
  description={bookData ? `${bookData.book.title} by ${bookData.book.author}. ${data.description}` : data.description}
  image={data.cover ?? bookData?.book.cover}
  type="article"
>
  <article class="post">
    <p class="term-prompt"><a href="/blog">~/blog</a> $ cat {fileName}</p>

    <header class="post-header">
      {seriesData && (
        <p class="post-series">
          <a href={getSeriesOverviewUrl(seriesData.series)}>[{series?.title ?? seriesData.series}]</a>
        </p>
      )}
      <h1 class="post-title">{data.title}</h1>
      {bookData && <p class="post-author">by {bookData.book.author}</p>}
      <p class="post-meta">
        <time datetime={data.date.toISOString()}>{data.date.toISOString().slice(0, 10)}</time>
        {data.tags.map((tag) => <span>#{tag}</span>)}
      </p>
    </header>

    {data.cover && !bookData && (
      <img
        src={data.cover}
        alt={data.title}
        class="post-cover"
      />
    )}

    {seriesData && (
      <SeriesNav entry={entry} />
    )}

    {bookData && (
      <BookMeta {...bookData.book} />
    )}

    {bookData?.book.rating && (
      <div class="post-rating">
        <span class="stars">{'★'.repeat(bookData.book.rating)}{'☆'.repeat(5 - bookData.book.rating)}</span>
        <span>my rating</span>
      </div>
    )}

    <div class="prose">
      <Content />
    </div>

    {seriesData?.series === 'gas-city' && (
      <NewsletterSignup
        heading="Enjoying the series?"
        description="I'll write more about multi-agent development and building with Gas City. No spam, unsubscribe any time."
      />
    )}

    <p class="post-outro">
      Have thoughts? <a href="https://x.com/jonaseriksson84" target="_blank" rel="noopener noreferrer" class="post-link">Find me on X</a> to continue the discussion.
    </p>

    {seriesData && (prevPost || nextPost) && (
      <nav class="post-pager">
        <div>
          {prevPost && (
            <a href={`/blog/${prevPost.id}`}>
              <span class="dir">&larr; prev</span>
              <span class="title">
                {prevPost.data.title}
              </span>
            </a>
          )}
        </div>
        <div class="next">
          {nextPost && (
            <a href={`/blog/${nextPost.id}`}>
              <span class="dir">next &rarr;</span>
              <span class="title">
                {nextPost.data.title}
              </span>
            </a>
          )}
        </div>
      </nav>
    )}
  </article>
</TerminalLayout>

<script>
  const COPY_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`;
  const CHECK_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 15 4 10"/></svg>`;

  // Wrap intro (everything before first h2) in a styled block
  const prose = document.querySelector('.prose');
  const firstH2 = prose?.querySelector('h2');
  if (prose && firstH2) {
    const intro = document.createElement('div');
    intro.className = 'prose-intro';
    let el = prose.firstElementChild;
    while (el && el !== firstH2) {
      const next = el.nextElementSibling;
      intro.appendChild(el);
      el = next;
    }
    if (intro.children.length > 0) {
      prose.insertBefore(intro, firstH2);
    }
  }

  document.querySelectorAll('article pre').forEach((pre) => {
    const wrapper = document.createElement('div');
    wrapper.className = 'copy-code-wrapper';
    pre.parentNode!.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    const button = document.createElement('button');
    button.innerHTML = COPY_ICON;
    button.setAttribute('aria-label', 'Copy code');
    button.setAttribute('title', 'Copy');
    button.className = 'copy-btn';
    wrapper.appendChild(button);

    button.addEventListener('click', () => {
      const code = pre.querySelector('code');
      navigator.clipboard.writeText(code?.innerText ?? '').then(() => {
        button.innerHTML = CHECK_ICON;
        setTimeout(() => { button.innerHTML = COPY_ICON; }, 1500);
      });
    });
  });

  // Click-to-zoom lightbox for content images (skips images that are already links)
  const zoomable = document.querySelectorAll<HTMLImageElement>('article .prose img, img.post-cover');
  if (zoomable.length) {
    const overlay = document.createElement('div');
    overlay.className = 'lightbox';
    overlay.setAttribute('aria-hidden', 'true');
    const big = document.createElement('img');
    overlay.appendChild(big);
    document.body.appendChild(overlay);

    const close = () => {
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      big.src = '';
    };
    overlay.addEventListener('click', close);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

    zoomable.forEach((img) => {
      if (img.closest('a')) return;
      img.classList.add('zoomable');
      img.addEventListener('click', () => {
        big.src = img.currentSrc || img.src;
        big.alt = img.alt || '';
        overlay.classList.add('is-open');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      });
    });
  }
</script>

<style is:global>
  .post-cover { width: 100%; margin-bottom: 32px; border: 1px solid var(--line); border-radius: 2px; }

  .post-rating { display: flex; align-items: baseline; gap: 10px; margin: -8px 0 32px; font-size: 13px; color: var(--muted); }
  .post-rating .stars { font-size: 20px; letter-spacing: 0.05em; color: var(--accent); }

  .post-outro { margin-top: 40px; padding-top: 24px; border-top: 1px dashed var(--line); font-size: 13px; color: var(--muted); }

  .post-pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 48px; padding-top: 24px; border-top: 1px dashed var(--line); }
  .post-pager a { display: flex; flex-direction: column; gap: 4px; }
  .post-pager .next a { align-items: flex-end; text-align: right; }
  .post-pager .dir { font-size: 12px; color: var(--muted); }
  .post-pager .title { font-size: 14px; font-weight: 500; transition: color 150ms ease; }
  .post-pager a:hover .title { color: var(--accent); }

  /* Wrapper restores the prose margins that pre would normally own */
  .copy-code-wrapper {
    position: relative;
    margin-top: 1.7143em;
    margin-bottom: 1.7143em;
  }

  .copy-code-wrapper pre {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }

  .copy-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 1.75rem;
    height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.3rem;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--panel) 80%, transparent);
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .copy-btn:hover {
    color: var(--accent);
    background: var(--panel);
  }

  /* Click-to-zoom images */
  img.zoomable {
    cursor: zoom-in;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: rgba(0, 0, 0, 0.85);
    cursor: zoom-out;
  }

  .lightbox.is-open {
    display: flex;
  }

  .lightbox img {
    max-width: 95vw;
    max-height: 92vh;
    object-fit: contain;
    border-radius: 0.5rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
  }
</style>
