---
import TerminalLayout from '../../layouts/TerminalLayout.astro';
import { getCollection } from 'astro:content';
import { getAllSeries } from '../../lib/series';

const allPosts = (await getCollection('blog')).filter((p) => !p.data.draft);
const standalonePosts = allPosts.filter((p) => p.data.type !== 'seriesPart');
const allSeries = await getAllSeries();

// One date-sorted feed, newest first. A series is dated by its first part.
const feed = [
  ...allSeries.map((series) => ({ kind: 'series' as const, date: series.parts[0].data.date, series })),
  ...standalonePosts.map((post) => ({ kind: 'post' as const, date: post.data.date, post })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const hasContent = allPosts.length > 0;
---

<TerminalLayout title="Blog — mynameisjonas">
  <p class="term-prompt">~ $ ls blog/</p>
  <h1 class="blog-title">Blog</h1>

  {!hasContent ? (
    <p class="entry-desc">No posts yet. Check back soon.</p>
  ) : (
    <ul class="feed">
      {feed.map((item) => {
        if (item.kind === 'series') {
          const series = item.series;
          const firstPart = series.parts[0];
          return (
            <li class="entry">
              {series.cover && (
                <a href={series.overviewUrl} class="entry-banner">
                  <img src={series.cover} alt={series.title} />
                </a>
              )}
              <p class="entry-meta">
                <time datetime={firstPart.data.date.toISOString()}>{firstPart.data.date.toISOString().slice(0, 10)}</time>
                <span class="entry-kind">[series &middot; {series.parts.length} parts]</span>
              </p>
              <h2 class="entry-title"><a href={series.overviewUrl}>{series.title}</a></h2>
              {series.description && <p class="entry-desc">{series.description}</p>}
              <ol class="parts">
                <li>
                  <a href={series.overviewUrl}><span class="num">&rarr;</span><span>Overview</span></a>
                </li>
                {series.parts.map((post) => (
                  <li>
                    <a href={`/blog/${post.id}`}>
                      <span class="num">{String(post.data.part).padStart(2, '0')}</span>
                      <span>{post.data.title.replace(/^Part \d+:\s*/i, '')}</span>
                    </a>
                  </li>
                ))}
              </ol>
              <p class="entry-tags">{firstPart.data.tags.map((tag) => <span>#{tag}</span>)}</p>
            </li>
          );
        }

        const post = item.post;
        const book = post.data.type === 'bookReview' ? post.data.book : null;
        return (
          <li class="entry">
            <a href={`/blog/${post.id}`} class="entry-row">
              {post.data.cover && (
                <img
                  class="entry-thumb"
                  src={post.data.cover}
                  alt={book ? book.title : post.data.title}
                />
              )}
              <div class="min-w-0">
                <p class="entry-meta">
                  <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
                  {book && <span class="entry-kind">[book review]</span>}
                </p>
                <h2 class="entry-title">{book ? book.title : post.data.title}</h2>
                {book && <p class="entry-author">by {book.author}</p>}
                <p class="entry-desc">{post.data.description}</p>
                <p class="entry-tags">{post.data.tags.map((tag) => <span>#{tag}</span>)}</p>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  )}
</TerminalLayout>

<style>
  .blog-title {
    margin: 20px 0 32px;
    font-weight: 500; font-size: clamp(28px, 5vw, 44px);
    line-height: 1.1; letter-spacing: -0.02em;
  }

  .feed { list-style: none; padding: 0; margin: 0; }

  .entry { padding: 28px 0; border-top: 1px dashed var(--line); }

  .entry-meta { display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 13px; color: var(--muted); }
  .entry-kind { color: var(--accent); }

  .entry-title {
    margin-top: 6px;
    font-weight: 500; font-size: 20px; line-height: 1.3; letter-spacing: -0.01em;
    transition: color 150ms ease;
  }

  .entry-title a:hover, .entry-row:hover .entry-title { color: var(--accent); }

  .entry-author { margin-top: 2px; font-size: 13px; color: var(--muted); }

  .entry-desc {
    margin-top: 8px;
    font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--body);
  }

  .entry-tags { display: flex; flex-wrap: wrap; gap: 4px 12px; margin-top: 10px; font-size: 12px; color: var(--muted); }

  .entry-row { display: flex; gap: 20px; align-items: flex-start; }

  /* Covers sit in greyscale so the page stays mono; colour comes back on hover. */
  .entry-thumb, .entry-banner img {
    border: 1px solid var(--line); border-radius: 2px;
    filter: grayscale(1) brightness(0.8);
    transition: filter 250ms ease;
  }

  .entry-row:hover .entry-thumb, .entry-banner:hover img { filter: none; }

  .entry-thumb { width: 64px; flex-shrink: 0; margin-top: 4px; }

  .entry-banner { display: block; margin-bottom: 16px; }
  .entry-banner img { width: 100%; height: 160px; object-fit: cover; display: block; }

  .parts {
    list-style: none; margin: 14px 0 0; padding: 0 0 0 16px;
    border-left: 1px solid var(--line);
    font-size: 14px;
  }

  .parts a { display: flex; gap: 12px; padding: 3px 0; color: var(--fg); transition: color 150ms ease; }
  .parts a:hover { color: var(--accent); }
  .parts .num { width: 2ch; flex-shrink: 0; color: var(--muted); font-variant-numeric: tabular-nums; }
</style>
